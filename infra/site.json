{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "playdate.thingelstad.xyz static site: private S3 origin, CloudFront, certificate, DNS records and access log",
  "Parameters": {
    "HostedZoneId": {
      "Type": "String",
      "Default": "Z00131847XOTS27DSIZF",
      "Description": "The thingelstad.xyz hosted zone (stack dns-thingelstad-xyz in projects-sysadmin)"
    }
  },
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "playdate.thingelstad.xyz",
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": "playdate.thingelstad.xyz",
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ]
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-web-${AWS::AccountId}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            },
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "ExpiredObjectDeleteMarker": true
            }
          ]
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTls",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": ["SiteBucket", "Arn"]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "CloudFrontReadsWebsite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Sid": "CloudFrontListsWebsiteForTrue404s",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::GetAtt": ["SiteBucket", "Arn"]
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-cache"
          },
          "Comment": "Honour each object's Cache-Control; nothing from the viewer in the key",
          "MinTTL": 0,
          "DefaultTTL": 300,
          "MaxTTL": 31536000,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "Headers": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "Comment": "Security headers for a static site that is never framed",
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "strict-origin-when-cross-origin",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            }
          }
        }
      }
    },
    "ViewerRequestFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-viewer-request"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Runtime": "cloudfront-js-2.0",
          "Comment": "Directory routes to index.html; extensionless paths 301 to the slash form, keeping the query"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  if (uri.endsWith('/')) request.uri = uri + 'index.html';\n  else if (uri.split('/').pop().indexOf('.') === -1) {\n    var query = Object.keys(request.querystring).map(function (k) {\n      var v = request.querystring[k];\n      return v.multiValue ? v.multiValue.map(function (m) { return k + '=' + m.value; }).join('&') : k + '=' + v.value;\n    }).join('&');\n    return { statusCode: 301, statusDescription: 'Moved Permanently', headers: { location: { value: uri + '/' + (query ? '?' + query : '') } } };\n  }\n  return request;\n}\n"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Playdate games by Jamie Thingelstad",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "WebACLId": {
            "Fn::ImportValue": "edge-waf-WebAclArn"
          },
          "DefaultRootObject": "index.html",
          "Aliases": ["playdate.thingelstad.xyz"],
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "Certificate"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "Origins": [
            {
              "Id": "website",
              "DomainName": {
                "Fn::GetAtt": ["SiteBucket", "RegionalDomainName"]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "website",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD"],
            "CachedMethods": ["GET", "HEAD"],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "ResponseHeadersPolicyId": {
              "Ref": "Headers"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "ViewerRequestFunction",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            }
          ]
        }
      }
    },
    "SiteRecordA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": "playdate.thingelstad.xyz.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": {
            "Fn::GetAtt": ["Distribution", "DomainName"]
          }
        }
      }
    },
    "SiteRecordAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": "playdate.thingelstad.xyz.",
        "Type": "AAAA",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": {
            "Fn::GetAtt": ["Distribution", "DomainName"]
          }
        }
      }
    },
    "AccessLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/playdate-xyz/web-access",
        "RetentionInDays": 731
      }
    },
    "AccessLogSource": {
      "Type": "AWS::Logs::DeliverySource",
      "Properties": {
        "Name": "playdate-xyz-web-access",
        "LogType": "ACCESS_LOGS",
        "ResourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "AccessLogDestination": {
      "Type": "AWS::Logs::DeliveryDestination",
      "Properties": {
        "Name": "playdate-xyz-web-access",
        "DestinationResourceArn": {
          "Fn::GetAtt": ["AccessLogGroup", "Arn"]
        },
        "OutputFormat": "json"
      }
    },
    "AccessLogDelivery": {
      "Type": "AWS::Logs::Delivery",
      "Properties": {
        "DeliverySourceName": {
          "Ref": "AccessLogSource"
        },
        "DeliveryDestinationArn": {
          "Fn::GetAtt": ["AccessLogDestination", "Arn"]
        },
        "RecordFields": [
          "timestamp(ms)",
          "cs-method",
          "cs-uri-stem",
          "sc-status",
          "sc-bytes",
          "sc-range-start",
          "sc-range-end",
          "time-taken",
          "time-to-first-byte",
          "x-edge-result-type",
          "x-edge-detailed-result-type",
          "x-edge-location",
          "cs-protocol",
          "cs(User-Agent)"
        ]
      }
    }
  },
  "Outputs": {
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      },
      "Description": "Private website origin"
    },
    "CertificateArn": {
      "Value": {
        "Ref": "Certificate"
      },
      "Description": "playdate.thingelstad.xyz HTTPS certificate"
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      },
      "Description": "Site distribution"
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": ["Distribution", "DomainName"]
      },
      "Description": "CloudFront domain the alias records point at"
    },
    "AccessLogGroup": {
      "Value": {
        "Ref": "AccessLogGroup"
      },
      "Description": "CloudFront access log, 731 days, no client IPs or query strings"
    }
  }
}
